<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <MySwmNativeX86 Condition="'$(MySwmNativeX86)' == ''">$(MSBuildProjectDirectory)\artifacts\win-x86\MySwm.dll</MySwmNativeX86>
    <MySwmNativeX64 Condition="'$(MySwmNativeX64)' == ''">$(MSBuildProjectDirectory)\artifacts\win-x64\MySwm.dll</MySwmNativeX64>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MySwmNativeX86)') and Exists('$(MySwmNativeX64)')">
    <None Include="$(MySwmNativeX86)" Pack="true" PackagePath="runtimes/win-x86/native/MySwm.dll" Visible="false" />
    <None Include="$(MySwmNativeX64)" Pack="true" PackagePath="runtimes/win-x64/native/MySwm.dll" Visible="false" />
  </ItemGroup>

  <Target Name="RequireMySwmNativeForPack" BeforeTargets="Pack">
    <Error Condition="!Exists('$(MySwmNativeX86)')" Text="MySwm x86 package asset missing: $(MySwmNativeX86)" />
    <Error Condition="!Exists('$(MySwmNativeX64)')" Text="MySwm x64 package asset missing: $(MySwmNativeX64)" />
  </Target>
</Project>
